{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrRepoManageFraudService",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DeleteRepository",
        "ecr:DescribeRepositories",
        "ecr:ListTagsForResource",
        "ecr:TagResource",
        "ecr:UntagResource",
        "ecr:PutLifecyclePolicy",
        "ecr:GetLifecyclePolicy",
        "ecr:GetLifecyclePolicyPreview"
      ],
      "Resource": "arn:aws:ecr:ap-south-1:264144511470:repository/fraud-detection-service"
    },
    {
      "Sid": "IamRolePolicyReadForTerraformEKS",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListRolePolicies",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws:iam::264144511470:role/*"
    }
  ]
}
